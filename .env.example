# ============================================================================
# ASTRO-AI MONOREPO ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and fill in secret values for your environment.
# NEVER commit .env to version control.
# ============================================================================

# --- Application Environment ---
APP_ENV=development
 TZ=UTC

# --- PostgreSQL Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=astro_ai
POSTGRES_USER=astro_user
POSTGRES_PASSWORD=change_me_in_production

# --- Spring Boot Backend ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=replace_with_at_least_256_bit_base64_encoded_secret_key_for_jwt_signing
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Python Deterministic Astrology Engine ---
ASTRO_ENGINE_HOST=localhost
ASTRO_ENGINE_PORT=8000
ASTRO_ENGINE_URL=http://localhost:8000
DEFAULT_AYANAMSHA=LAHIRI
DEFAULT_NODE_TYPE=MEAN_NODE
DEFAULT_HOUSE_SYSTEM=WHOLE_SIGN_WITH_SRIPATI
DEFAULT_DASHA_YEAR_DAYS=365.2425
RAHU_KETU_TRINAL_ASPECTS=false

# --- Geocoding & Location Service ---
# Supported: NOMINATIM (default free), GOOGLE_MAPS, MAPBOX
GEOCODING_PROVIDER=NOMINATIM
GEOCODING_USER_AGENT=AstroAI-Platform/1.0
GOOGLE_MAPS_API_KEY=

# --- AI / LLM Service Abstraction ---
# Supported: MOCK (deterministic offline synthesis), GEMINI, OPENAI, ANTHROPIC, OLLAMA
AI_PROVIDER=MOCK
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8080/api
