# ==============================================================================
# ASTRO-AI PRODUCTION ENVIRONMENT CONFIGURATION (.env.production.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env.production` on your target production host:
#      cp .env.production.example .env.production
# 2. Generate strong, cryptographically secure credentials for:
#      - POSTGRES_PASSWORD
#      - JWT_SECRET (must be at least 256-bit base64-encoded, e.g. `openssl rand -base64 48`)
# 3. Specify your official domain names in CORS_ALLOWED_ORIGINS and VIRTUAL_HOST.
# 4. NEVER check `.env.production` into source control.
# ==============================================================================

# --- Global Environment ---
APP_ENV=production
TZ=UTC

# --- PostgreSQL Production Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=astro_ai_prod
POSTGRES_USER=astro_admin
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD_IN_PRODUCTION
# Connection pool settings for HikariCP
DB_MAX_POOL_SIZE=25
DB_MIN_IDLE=5

# --- Spring Boot Backend API ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_AT_LEAST_256_BIT_BASE64_ENCODED_CRYPTOGRAPHIC_KEY_IN_PRODUCTION
# Access token validity: 15 minutes (900000 ms)
JWT_ACCESS_EXPIRATION_MS=900000
# Refresh token validity: 7 days (604800000 ms)
JWT_REFRESH_EXPIRATION_MS=604800000
# Comma-separated list of trusted production origins (NO wildcards in production)
CORS_ALLOWED_ORIGINS=https://kundli.example.com,https://app.astroai.com

# --- Python Deterministic Astrology Engine ---
ASTRO_ENGINE_URL=http://astrology-engine:8000
ASTRO_ENGINE_PORT=8000
DEFAULT_AYANAMSHA=LAHIRI
DEFAULT_NODE_TYPE=MEAN_NODE
DEFAULT_HOUSE_SYSTEM=WHOLE_SIGN_WITH_SRIPATI
DEFAULT_DASHA_YEAR_DAYS=365.2425
RAHU_KETU_TRINAL_ASPECTS=false
# Number of uvicorn worker processes in container
WORKERS=4

# --- Geocoding & Timezone Service ---
GEOCODING_PROVIDER=NOMINATIM
GEOCODING_USER_AGENT=AstroAI-Enterprise/1.0 (contact@astroai.com)
# Optional Google Maps API Key for high-volume geocoding
GOOGLE_MAPS_API_KEY=

# --- AI / LLM Cognitive Service Provider ---
# Options: GEMINI, OPENAI, ANTHROPIC, MOCK
AI_PROVIDER=MOCK
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Nginx & Public Web Gateway ---
HTTP_PORT=80
HTTPS_PORT=443
VIRTUAL_HOST=kundli.example.com
