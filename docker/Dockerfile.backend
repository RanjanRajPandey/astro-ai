# ==============================================================================
# Astro-AI Backend (Spring Boot 3 + Embedded Deterministic Astrology Engine)
# Multi-Stage Production Dockerfile (100% Self-Contained)
# ==============================================================================

# Stage 1: Build Spring Boot JAR
FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /workspace/app

RUN apk add --no-cache dos2unix

COPY mvnw .
COPY .mvn .mvn
COPY pom.xml .

RUN dos2unix mvnw && chmod +x mvnw
RUN ./mvnw dependency:go-offline -B || true

COPY src src
RUN ./mvnw clean package -DskipTests -B

# Stage 2: Production Runtime with Java 21 + Python 3.11 Astrology Engine
FROM eclipse-temurin:21-jre
LABEL maintainer="Astro-AI Platform Team"

WORKDIR /app

# Install Python 3, venv, and curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set up Python virtual environment and dependencies
COPY astrology-engine /app/astrology-engine
RUN python3 -m venv /app/venv && \
    /app/venv/bin/pip install --no-cache-dir -r /app/astrology-engine/requirements.txt && \
    ln -s /app/venv /app/astrology-engine/.venv

ENV PATH="/app/venv/bin:${PATH}"

# Run as non-root user for security
RUN groupadd -g 10001 astro && \
    useradd -u 10001 -g astro -s /bin/bash -m astro && \
    mkdir -p /app/logs && \
    chown -R astro:astro /app

COPY --from=build --chown=astro:astro /workspace/app/target/*.jar /app/app.jar

# Create entrypoint script that launches both Uvicorn (engine) and Spring Boot
RUN printf '#!/bin/bash\n\
echo "Starting embedded deterministic Python astrology engine on 127.0.0.1:8000..."\n\
/app/venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8000 --app-dir /app/astrology-engine --workers 2 &\n\
echo "Starting Spring Boot core reasoning API on port ${PORT:-8080}..."\n\
exec java -XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom -jar /app/app.jar\n' > /app/entrypoint.sh && \
    chmod +x /app/entrypoint.sh && \
    chown astro:astro /app/entrypoint.sh

USER astro

EXPOSE 8080 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=45s \
  CMD curl -f http://127.0.0.1:${PORT:-8080}/actuator/health || exit 0

ENTRYPOINT ["/app/entrypoint.sh"]
